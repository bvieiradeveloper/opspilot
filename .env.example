# Required by model-backed API requests.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional fallback model.
OPENROUTER_MODEL_FALLBACK=

# API server and local persistence.
PORT=3000
OPSPILOT_DB=./data/opspilot.db

# Optional War Room configuration. Set both values to enable the web integration.
# OPSPILOT_USER_ID=oncall-primary
# OPSPILOT_WEB_ORIGINS=http://localhost:5173,https://bvieiradeveloper.github.io

# Optional context size overrides.
CONTEXT_BUDGET_SUMMARY=100
CONTEXT_BUDGET_HISTORY=300
CONTEXT_BUDGET_MEMORIES=100