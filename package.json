{
  "name": "ops-pilot",
  "version": "1.0.0",
  "description": "Copiloto de plantão para alertas e incidentes de produção",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"web/src/**/*.test.ts\" \"web/src/**/*.test.tsx\"",
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "arena": "node --env-file=.env --import tsx src/arena.ts",
    "seed": "tsx src/scripts/seed.ts",
    "bench": "node --env-file=.env --import tsx src/bench.ts",
    "mcp": "node --env-file-if-exists=.env --import tsx src/mcp/server.ts",
    "typecheck": "tsc --noEmit -p src/tsconfig.json",
    "build": "npm run typecheck && npm run web:typecheck && npm run web:build",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:typecheck": "tsc --noEmit -p web/tsconfig.json"
  },
  "workspaces": [
    "web"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@langchain/core": "^1.2.12",
    "@langchain/langgraph": "^1.4.17",
    "@langchain/openai": "^1.5.13",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
